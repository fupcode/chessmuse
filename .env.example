# Copy to .env and fill in your own key. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Non-thinking mode by default; enable thinking only with an adequate token budget.
LLM_THINKING=disabled
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# Additional attempts after transient HTTP/network failures; 0 disables retries.
LLM_MAX_RETRIES=2
